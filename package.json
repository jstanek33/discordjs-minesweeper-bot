{
  "name": "discord-minesweeper-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "commit": "czg",
    "register-commands": "node --env-file-if-exists=.env.local dist/register-commands.mjs",
    "dev": "pnpm build && node --env-file-if-exists=.env.local dist/index.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "knip:debug": "knip --debug",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:type-aware": "oxlint --type-aware --type-check --report-unused-disable-directives",
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "start": "node --env-file-if-exists=.env.local dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.1.0",
    "czg": "^1.14.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
